# ---------------------------------------------------------------------------
# Template. Prefer generating the real file:
#
#   export API_ENCRYPTION_KEY=... OTA_PASSWORD=... WEB_PASSWORD=... \
#          MQTT_BROKER=... MQTT_USERNAME=... MQTT_PASSWORD=...
#   firmware/make-secrets.sh
#
# No WiFi credentials anywhere: the lamp is provisioned per device over USB or
# its setup hotspot. See README.
#
# Everything below ends up inside the published firmware image, which anyone can
# download from the installer page. Treat it as public — that is why the MQTT
# credential here must be the subscribe-only one.
# ---------------------------------------------------------------------------

# openssl rand -base64 32
api_encryption_key: "REPLACE_ME"

# openssl rand -hex 16
ota_password: "REPLACE_ME"

web_username: "nexus"
web_password: "REPLACE_ME"

# HiveMQ Cloud cluster hostname, without scheme and without port.
mqtt_broker: "REPLACE_ME.s1.eu.hivemq.cloud"

# The SUBSCRIBE-ONLY broker credential, restricted to nexus/v1/pr/#.
# The publish credential belongs in GitHub Actions secrets and nowhere else.
mqtt_username: "nexus-lamp"
mqtt_password: "REPLACE_ME"

# Public root certificate. make-secrets.sh injects firmware/mqtt_ca.pem here.
mqtt_ca_cert: |
  -----BEGIN CERTIFICATE-----
  ... ISRG Root X1, see firmware/mqtt_ca.pem ...
  -----END CERTIFICATE-----
